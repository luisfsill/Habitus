{
  "expo": {
    "name": "Habitus",
    "slug": "habitus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "habitus",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.habitus.app",
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleDevelopmentRegion": "pt-BR"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A7CC0",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.habitus.app",
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E3F1F8",
          "dark": {
            "backgroundColor": "#041526"
          },
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0369A1",
          "icon": "./assets/images/notification-icon.png"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-asset",
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "O Habitus usa suas fotos só para a foto do perfil.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "description": "Seis práticas de bem-estar ao longo do dia, com lembretes locais."
  }
}
